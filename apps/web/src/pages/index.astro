---
import Base from "../layouts/Base.astro";

// "Hola" en varios idiomas para la cinta inferior (se duplica para que el bucle no tenga corte).
const HELLOS = ["Hello", "Hola", "Bonjour", "Olá", "Ciao", "Hallo", "こんにちは", "Merhaba", "안녕하세요", "Hej", "Привет", "你好", "Namaste", "Salut"];
---

<Base title="Iniciar sesión · Global AI">
  <main class="login">
    <header class="top">
      <div class="brand"><span class="mark" aria-hidden="true"></span>Global AI</div>
      <p class="meta">Evaluación de nivel <span aria-hidden="true">·</span> MCER Pre-A1 → C1</p>
    </header>

    <section class="hero" aria-hidden="true">
      <p class="tag"><span class="live"></span>Glo · tu coach de inglés</p>
      <p class="say" id="say" lang="en"></p>
      <p class="say-es" id="say-es"></p>
      <canvas id="coach"></canvas>
    </section>

    <section class="panel" aria-labelledby="title">
      <h1 id="title">Descubre tu nivel de inglés</h1>
      <p class="lead">10 preguntas · ~10 minutos · resultados al instante por habilidad.</p>

      <form id="login" novalidate>
        <div class="field">
          <label for="email">Correo electrónico</label>
          <input
            id="email"
            name="email"
            type="email"
            inputmode="email"
            autocomplete="username"
            placeholder="nombre@correo.com"
            aria-describedby="email-error"
            required
          />
          <p class="field-error" id="email-error"></p>
        </div>

        <div class="field">
          <label for="password">Contraseña</label>
          <div class="password">
            <input
              id="password"
              name="password"
              type="password"
              autocomplete="current-password"
              aria-describedby="password-error caps"
              required
            />
            <button type="button" class="toggle" id="toggle" aria-pressed="false">
              <svg viewBox="0 0 24 24" aria-hidden="true"
                ><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"></path><circle cx="12" cy="12" r="3"></circle><path class="slash" d="M4 4l16 16"></path></svg
              >
              <span class="sr-only">Mostrar contraseña</span>
            </button>
          </div>
          <p class="hint" id="caps" hidden>Bloq Mayús está activado</p>
          <p class="field-error" id="password-error"></p>
        </div>

        <p class="form-error" id="form-error" role="alert"></p>

        <button type="submit" class="primary" id="submit">
          <span class="label">Entrar</span>
          <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </button>

        <div class="demo-row">
          <span>¿Solo quieres explorar?</span>
          <button type="button" class="link" id="demo">Usar la cuenta demo</button>
        </div>
      </form>
    </section>

    <div class="marquee" aria-hidden="true">
      <div class="track">
        {[...HELLOS, ...HELLOS].map((h) => <span>{h}</span>)}
      </div>
    </div>
  </main>
</Base>

<style>
  /* Escena nocturna a sangre completa: Glo es el protagonista, el formulario es "la respuesta". */
  .login {
    --night: var(--stage);
    --cream: var(--bg);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(340px, 440px);
    grid-template-rows: auto 1fr auto;
    column-gap: clamp(24px, 4vw, 72px);
    min-height: 100dvh;
    padding: clamp(16px, 2.4vw, 36px) clamp(16px, 3vw, 48px) 0;
    overflow: hidden;
    color: var(--cream);
    background:
      radial-gradient(circle at 36% 62%, rgb(255 75 58 / 0.28), transparent 38%),
      radial-gradient(circle at 90% 10%, rgb(43 68 199 / 0.45), transparent 45%),
      radial-gradient(circle, rgb(246 241 231 / 0.1) 1px, transparent 1.4px) 0 0 / 26px 26px,
      var(--night);
  }

  .top {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    animation: fade 0.8s var(--ease-out) both;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  /* Marca: mini globo de diálogo coral, el mismo gesto que Glo. */
  .mark {
    position: relative;
    width: 22px;
    height: 18px;
    border-radius: 50%;
    background: var(--glo);
  }
  .mark::after {
    content: "";
    position: absolute;
    left: 2px;
    bottom: -4px;
    border: 5px solid transparent;
    border-top-color: var(--glo);
    border-left-width: 2px;
    rotate: 20deg;
  }
  .meta {
    margin: 0;
    font-size: 0.8rem;
    opacity: 0.7;
  }

  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 0;
    padding-block: clamp(16px, 4vh, 48px);
  }
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 18px;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.75;
  }
  .live {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--glo);
    box-shadow: 0 0 0 0 var(--glo);
    animation: live 2s ease-out infinite;
  }
  /* Lo que dice Glo, en tamaño póster. Glo flota por delante de las letras. */
  .say {
    position: relative;
    z-index: 0;
    max-width: 8.5ch;
    margin: 0;
    font-size: clamp(2.6rem, min(7.4vw, 13vh), 7rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.045em;
  }
  /* Las palabras se crean en JS: :global para que les lleguen los estilos con scope. */
  .say :global(.w) {
    display: inline-block;
    overflow: clip;
    overflow-clip-margin: 0.12em;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
    vertical-align: top;
  }
  .say :global(.w > span) {
    display: inline-block;
    animation: word 0.7s calc(var(--i) * 0.07s) var(--ease-out) both;
  }
  .say :global(.hi) {
    color: var(--glo);
    text-decoration: underline wavy var(--glo);
    text-decoration-thickness: 0.055em;
    text-underline-offset: 0.14em;
  }
  .say-es {
    position: relative;
    z-index: 0;
    max-width: 30ch;
    margin: 20px 0 0;
    font-size: 1rem;
    opacity: 0.7;
  }
  .say-es.in {
    animation: fade 0.6s 0.35s var(--ease-out) both;
  }
  canvas {
    position: absolute;
    z-index: 1;
    right: -7%;
    bottom: 0;
    width: min(60%, 68vh, 600px);
    aspect-ratio: 1;
    animation: glo-in 1.1s 0.2s var(--ease-spring) both;
  }

  /* Tarjeta de papel con colita de diálogo apuntando a Glo: responder es conversar. */
  .panel {
    position: relative;
    align-self: center;
    padding: clamp(28px, 3vw, 40px);
    border-radius: 28px;
    color: var(--ink);
    background: var(--surface);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.6) inset,
      0 40px 80px -30px rgb(0 0 0 / 0.65);
    animation: card-in 0.9s 0.15s var(--ease-out) both;
  }
  .panel::before {
    content: "";
    position: absolute;
    left: -14px;
    top: 42%;
    width: 30px;
    height: 30px;
    background: var(--surface);
    border-radius: 0 0 0 6px;
    rotate: 45deg;
    clip-path: polygon(0 0, 0 100%, 100% 100%);
  }
  h1 {
    font-size: clamp(1.5rem, 2.2vw, 1.85rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin: 0 0 8px;
  }
  .lead {
    color: var(--muted);
    font-size: 0.9rem;
    margin: 0 0 28px;
  }

  .field {
    margin-bottom: 16px;
  }
  label {
    display: block;
    font-weight: 500;
    font-size: 0.85rem;
    margin-bottom: 6px;
  }
  input {
    width: 100%;
    height: 52px;
    padding: 0 16px;
    font: inherit;
    color: var(--ink);
    background: var(--bg);
    border: 1.5px solid transparent;
    border-radius: 14px;
    transition:
      border-color 0.2s,
      background 0.2s,
      box-shadow 0.25s var(--ease-out);
  }
  input::placeholder {
    color: color-mix(in srgb, var(--muted) 65%, transparent);
  }
  input:hover {
    border-color: var(--line);
  }
  input:focus {
    outline: none;
    background: var(--surface);
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }
  input[aria-invalid="true"] {
    border-color: var(--danger);
    box-shadow: 0 0 0 4px var(--danger-soft);
  }

  .password {
    position: relative;
  }
  .password input {
    padding-right: 56px;
  }
  .toggle {
    position: absolute;
    right: 4px;
    top: 4px;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: var(--muted);
    transition:
      background 0.2s,
      color 0.2s;
  }
  .toggle:hover {
    background: var(--accent-soft);
    color: var(--accent);
  }
  .toggle svg {
    width: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }
  /* La barra se "dibuja" al ocultar: micro animación con stroke-dashoffset. */
  .slash {
    stroke-dasharray: 23;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 0.3s var(--ease-out);
  }
  .toggle[aria-pressed="true"] .slash {
    stroke-dashoffset: 23;
  }

  .hint,
  .field-error {
    margin: 6px 0 0;
    font-size: 0.8rem;
  }
  .hint {
    color: var(--muted);
  }
  .field-error:empty,
  .form-error:empty {
    display: none;
  }
  .field-error,
  .form-error {
    color: var(--danger);
    animation: fade 0.3s var(--ease-out);
  }
  .form-error {
    margin: 0 0 16px;
    padding: 12px 14px;
    border-radius: 12px;
    background: var(--danger-soft);
    font-size: 0.85rem;
  }

  button {
    font: inherit;
    cursor: pointer;
  }
  .primary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    height: 54px;
    margin-top: 8px;
    border: 0;
    border-radius: 14px;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 500;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.18),
      0 12px 24px -12px color-mix(in srgb, var(--accent) 80%, transparent);
    transition:
      background 0.2s,
      transform 0.15s var(--ease-out),
      box-shadow 0.25s var(--ease-out);
  }
  .primary:hover {
    background: color-mix(in srgb, var(--accent) 88%, black);
  }
  .primary:active {
    transform: translateY(1px) scale(0.99);
  }
  .arrow {
    width: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: translate 0.3s var(--ease-spring);
  }
  .primary:hover .arrow {
    translate: 4px 0;
  }
  .primary[aria-busy="true"] {
    cursor: progress;
  }
  .primary[aria-busy="true"] .arrow {
    display: none;
  }
  .primary[aria-busy="true"] .label::after {
    content: "";
    display: inline-block;
    width: 1.2em;
    text-align: left;
    animation: dots 1s steps(4) infinite;
  }

  .demo-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    margin-top: 18px;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .link {
    padding: 0;
    border: 0;
    background: none;
    color: var(--accent);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: text-underline-offset 0.2s var(--ease-out);
  }
  .link:hover {
    text-underline-offset: 6px;
  }

  /* Cinta de "hola" en muchos idiomas: lo global, en movimiento. */
  .marquee {
    grid-column: 1 / -1;
    margin-inline: calc(-1 * clamp(16px, 3vw, 48px));
    padding-block: 14px;
    border-top: 1px solid rgb(246 241 231 / 0.12);
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    animation: fade 1s 0.6s both;
  }
  .track {
    display: flex;
    width: max-content;
    animation: marquee 50s linear infinite;
  }
  .track span {
    display: flex;
    align-items: center;
    gap: 28px;
    padding-right: 28px;
    font-size: 0.95rem;
    white-space: nowrap;
    opacity: 0.45;
  }
  .track span::after {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--glo);
  }

  .shake {
    animation: shake 0.4s var(--ease-out);
  }

  @keyframes word {
    from {
      translate: 0 105%;
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
      translate: 0 8px;
    }
  }
  @keyframes card-in {
    from {
      opacity: 0;
      translate: 24px 0;
    }
  }
  @keyframes glo-in {
    from {
      opacity: 0;
      scale: 0.6;
      translate: 0 40px;
    }
  }
  @keyframes marquee {
    to {
      translate: -50% 0;
    }
  }
  @keyframes live {
    70%,
    100% {
      box-shadow: 0 0 0 8px transparent;
    }
  }
  @keyframes shake {
    25%,
    75% {
      translate: -5px 0;
    }
    50% {
      translate: 5px 0;
    }
  }
  @keyframes dots {
    0% {
      content: "";
    }
    25% {
      content: ".";
    }
    50% {
      content: "..";
    }
    75% {
      content: "...";
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
    }
  }

  /* Portátiles bajos: compacta sin tocar la legibilidad. */
  @media (min-width: 861px) and (max-height: 720px) {
    .lead {
      margin-bottom: 20px;
    }
    .field {
      margin-bottom: 12px;
    }
    .marquee {
      padding-block: 10px;
    }
  }

  @media (max-width: 860px) {
    .login {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto 1fr auto;
      row-gap: 16px;
    }
    .hero {
      display: grid;
      grid-template-columns: 1fr 120px;
      align-items: end;
      padding-block: 8px 0;
    }
    .tag,
    .say-es {
      grid-column: 1 / -1;
    }
    .say {
      grid-column: 1;
      max-width: none;
      font-size: clamp(2rem, 9vw, 3rem);
    }
    .say-es {
      margin-top: 10px;
      font-size: 0.85rem;
    }
    canvas {
      position: static;
      grid-column: 2;
      grid-row: 2;
      width: 120px;
    }
    .panel {
      align-self: start;
      margin-bottom: 16px;
    }
    .panel::before {
      left: auto;
      right: 48px;
      top: -12px;
      rotate: 135deg;
    }
    .top .meta {
      display: none;
    }
  }
</style>

<script>
  import type { CoachState } from "../lib/coach";

  const API = "/api/v1";
  const DEMO = { email: "estudiante@globalai.demo", password: "Demo1234!" };
  const LINES: Record<CoachState, [string, string]> = {
    // *palabra* = se resalta en coral.
    idle: ["Hi, I'm Glo. Let's find your *level.*", "Hola, soy Glo. Descubramos tu nivel de inglés."],
    email: ["Nice to *meet* you!", "¡Un gusto conocerte!"],
    password: ["I'm not *looking.* Promise.", "No estoy mirando. Lo prometo."],
    peek: ["Oops! I can *see* it.", "¡Uy! Ahora sí la veo."],
    loading: ["Let me *check*…", "Déjame revisar…"],
    error: ["Hmm. Let's try *again.*", "Mmm. Intentémoslo de nuevo."],
    success: ["You're in. *Let's go!*", "Estás dentro. ¡Vamos!"],
  };

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const form = $<HTMLFormElement>("login");
  const email = $<HTMLInputElement>("email");
  const password = $<HTMLInputElement>("password");
  const toggle = $<HTMLButtonElement>("toggle");
  const submit = $<HTMLButtonElement>("submit");
  const demo = $<HTMLButtonElement>("demo");
  const formError = $("form-error");
  const say = $("say");
  const sayEs = $("say-es");

  // Three.js se carga después: el formulario funciona desde el primer instante.
  let coach: { setState(s: CoachState): void; pulse(): void; gaze(x: number): void; say(s: number): void } | undefined;
  import("../lib/coach")
    .then(({ createCoach }) => (coach = createCoach($<HTMLCanvasElement>("coach"))))
    .catch(() => $("coach").remove()); // sin WebGL: queda la tipografía

  let current: CoachState = "idle";
  function mood(s: CoachState) {
    coach?.setState(s);
    if (s === current) return;
    current = s;
    speak(...LINES[s]);
  }

  // Tipografía cinética: cada palabra sube desde una máscara, al ritmo en que Glo mueve la boca.
  function speak(en: string, es: string) {
    say.replaceChildren();
    en.split(" ").forEach((word, i) => {
      const mask = document.createElement("span");
      const w = document.createElement("span");
      mask.className = "w";
      w.textContent = word.replaceAll("*", "");
      if (word.startsWith("*")) w.className = "hi";
      w.style.setProperty("--i", String(i));
      mask.append(w);
      say.append(mask, " ");
    });
    sayEs.textContent = es;
    sayEs.classList.remove("in");
    void sayEs.offsetWidth; // reinicia la animación
    sayEs.classList.add("in");
    coach?.say(0.5 + en.split(" ").length * 0.22);
  }
  speak(...LINES.idle);

  const fieldMood = () =>
    document.activeElement === email ? "email"
    : document.activeElement === password || document.activeElement === toggle ? (password.type === "text" ? "peek" : "password")
    : "idle";

  email.addEventListener("focus", () => mood("email"));
  password.addEventListener("focus", () => mood(fieldMood()));
  for (const input of [email, password]) {
    input.addEventListener("blur", () => setTimeout(() => current !== "loading" && mood(fieldMood()), 0));
    input.addEventListener("input", () => {
      coach?.pulse();
      setFieldError(input, "");
    });
  }

  // Glo sigue con la mirada el cursor mientras escribes el correo (~32 caracteres llenan el campo).
  const followCaret = () => coach?.gaze((email.selectionStart ?? email.value.length) / 32);
  for (const ev of ["input", "keyup", "click", "focus"]) email.addEventListener(ev, followCaret);

  toggle.addEventListener("click", () => {
    const show = password.type === "password";
    password.type = show ? "text" : "password";
    toggle.setAttribute("aria-pressed", String(show));
    toggle.querySelector(".sr-only")!.textContent = show ? "Ocultar contraseña" : "Mostrar contraseña";
    mood(show ? "peek" : "password");
  });

  const caps = $("caps");
  const checkCaps = (e: KeyboardEvent) => (caps.hidden = !e.getModifierState?.("CapsLock"));
  password.addEventListener("keydown", checkCaps);
  password.addEventListener("keyup", checkCaps);

  function setFieldError(input: HTMLInputElement, msg: string) {
    $(`${input.id}-error`).textContent = msg;
    if (msg) input.setAttribute("aria-invalid", "true");
    else input.removeAttribute("aria-invalid");
  }

  function validate() {
    const e = email.value.trim();
    const emailMsg = !e ? "Escribe tu correo electrónico."
      : !email.checkValidity() ? "Revisa el correo, debe verse así: nombre@correo.com"
      : "";
    const passMsg = password.value ? "" : "Escribe tu contraseña.";
    setFieldError(email, emailMsg);
    setFieldError(password, passMsg);
    (emailMsg ? email : passMsg ? password : null)?.focus();
    return !emailMsg && !passMsg;
  }

  function fail(msg: string) {
    formError.textContent = msg;
    form.classList.remove("shake");
    void form.offsetWidth;
    form.classList.add("shake");
    mood("error");
  }

  let busy = false;
  form.addEventListener("submit", async (ev) => {
    ev.preventDefault();
    if (busy) return;
    formError.textContent = "";
    if (!validate()) return fail(""); // los errores ya están junto a cada campo

    busy = true;
    submit.setAttribute("aria-busy", "true");
    submit.querySelector(".label")!.textContent = "Entrando";
    mood("loading");
    try {
      const res = await fetch(`${API}/auth/login`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email: email.value.trim(), password: password.value }),
      });
      if (res.ok) {
        submit.removeAttribute("aria-busy");
        submit.querySelector(".label")!.textContent = "¡Listo!";
        mood("success");
        setTimeout(() => location.assign("/dashboard"), 900);
        return;
      }
      const body = await res.json().catch(() => null);
      fail(body?.error?.message ?? "Algo salió mal. Inténtalo de nuevo.");
    } catch {
      fail("No pudimos conectar con el servidor. Revisa tu conexión e inténtalo de nuevo.");
    }
    busy = false;
    submit.removeAttribute("aria-busy");
    submit.querySelector(".label")!.textContent = "Entrar";
  });

  // Cuenta demo: se "escribe" sola para que el coach reaccione, y entra.
  demo.addEventListener("click", async () => {
    if (busy) return;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    for (const [input, value] of [[email, DEMO.email], [password, DEMO.password]] as const) {
      input.focus();
      input.value = "";
      for (const ch of value) {
        input.value += ch;
        input.dispatchEvent(new Event("input"));
        if (!reduced) await new Promise((r) => setTimeout(r, 28));
      }
    }
    form.requestSubmit();
  });

  // Si ya hay sesión, no tiene sentido mostrar el login.
  fetch(`${API}/auth/me`).then((r) => r.ok && location.replace("/dashboard"), () => {});
</script>
