---
import "../styles/global.css";

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f1e7" />
    <meta name="color-scheme" content="light dark" />
    <!-- Tema antes del primer pintado (sin destello). Siempre claro salvo que el usuario haya elegido oscuro. -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const apply = (theme) => {
          root.dataset.theme = theme;
          document.querySelector('meta[name="theme-color"]')?.setAttribute("content", theme === "dark" ? "#15130f" : "#f6f1e7");
        };
        let saved;
        try { saved = localStorage.theme; } catch {}
        apply(saved === "dark" ? "dark" : "light");
        // Si esta página abrirá la pantalla de carga (ver lib/splash.ts), el contenido no se pinta antes que ella.
        let splashing = location.pathname.startsWith("/results");
        try { splashing ||= !!sessionStorage.getItem("ga:splash") || (location.pathname === "/" && !sessionStorage.getItem("ga:seen")); } catch {}
        if (splashing) {
          root.classList.add("splashing");
          setTimeout(() => root.classList.remove("splashing"), 4000); // red de seguridad si el script falla
        }
        // Revela el tema nuevo en círculo desde el punto (x, y) del clic y guarda la elección.
        window.toggleTheme = (x = innerWidth / 2, y = 0) => {
          const next = root.dataset.theme === "dark" ? "light" : "dark";
          const swap = () => { try { localStorage.theme = next; } catch {} apply(next); };
          if (!document.startViewTransition || matchMedia("(prefers-reduced-motion: reduce)").matches) return swap();
          const r = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
          document.startViewTransition(swap).ready.then(() =>
            root.animate(
              { clipPath: [`circle(0 at ${x}px ${y}px)`, `circle(${r}px at ${x}px ${y}px)`] },
              { duration: 550, easing: "cubic-bezier(0.22, 1, 0.36, 1)", pseudoElement: "::view-transition-new(root)" },
            ),
          );
        };
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Lexend:wght@400..700&display=swap"
    />
    <title>{title}</title>
    <!-- Vista previa al compartir el enlace (WhatsApp, Slack, X…). Las URLs deben ser absolutas. -->
    <meta name="description" content="Descubre tu nivel de inglés MCER con Glo en 25 minutos. Resultados al instante por habilidad." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Global AI" />
    <meta property="og:title" content="What's your English level? · Global AI" />
    <meta property="og:description" content="Descubre tu nivel MCER con Glo en 25 minutos. Resultados al instante." />
    <meta property="og:url" content="https://glob.jhongdlp.com/" />
    <meta property="og:image" content="https://glob.jhongdlp.com/og.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Glo, la mascota coral de Global AI, junto al título What's your English level?" />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
    {import.meta.env.PROD && <script is:inline>navigator.serviceWorker?.register("/sw.js")</script>}
  </body>
</html>
