---
import Base from "../layouts/Base.astro";
import "../styles/glo.css";

// "Hola" en varios idiomas para la cinta inferior (se duplica para que el bucle no tenga corte).
const HELLOS = ["Hello", "Hola", "Bonjour", "Olá", "Ciao", "Hallo", "こんにちは", "Merhaba", "안녕하세요", "Hej", "Привет", "你好", "Namaste", "Salut"];
---

<Base title="Iniciar sesión · Global AI">
  <main class="login night">
    <header class="top">
      <div class="brand"><span class="mark" aria-hidden="true"></span>Global AI</div>
      <p class="meta">Evaluación de nivel <span aria-hidden="true">·</span> MCER Pre-A1 → C1</p>
    </header>

    <section class="hero quote-mark" aria-hidden="true">
      <p class="say" id="say" lang="en"></p>
      <p class="say-es" id="say-es"></p>
      <p class="by">Glo, tu coach de inglés</p>
      <canvas id="coach"></canvas>
    </section>

    <section class="panel" aria-labelledby="title">
      <h1 id="title">Descubre tu nivel de inglés</h1>
      <p class="lead">10 preguntas + 3 orales · 25 min · resultados al instante por habilidad.</p>

      <form id="login" novalidate>
        <div class="field">
          <label for="email">Correo electrónico</label>
          <input
            id="email"
            name="email"
            type="email"
            inputmode="email"
            autocomplete="username"
            placeholder="nombre@correo.com"
            aria-describedby="email-error"
            required
          />
          <p class="field-error" id="email-error"></p>
        </div>

        <div class="field">
          <label for="password">Contraseña</label>
          <div class="password">
            <input
              id="password"
              name="password"
              type="password"
              autocomplete="current-password"
              aria-describedby="password-error caps"
              required
            />
            <button type="button" class="toggle" id="toggle" aria-pressed="false">
              <svg viewBox="0 0 24 24" aria-hidden="true"
                ><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"></path><circle cx="12" cy="12" r="3"></circle><path class="slash" d="M4 4l16 16"></path></svg
              >
              <span class="sr-only">Mostrar contraseña</span>
            </button>
          </div>
          <p class="hint" id="caps" hidden>Bloq Mayús está activado</p>
          <p class="field-error" id="password-error"></p>
        </div>

        <div class="field consent">
          <label>
            <input id="terms" name="terms" type="checkbox" aria-describedby="terms-error" required />
            <span>Acepto los <a href="/terminos" target="_blank">Términos</a> y la <a href="/privacidad" target="_blank">Política de privacidad</a>.</span>
          </label>
          <p class="field-error" id="terms-error"></p>
        </div>

        <p class="form-error" id="form-error" role="alert"></p>

        <button type="submit" class="primary" id="submit">
          <span class="label">Entrar</span>
          <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </button>

        <!-- Solo visual: muestra que el login social encaja en el flujo; se activa con OAuth real. -->
        <button type="button" class="google" disabled aria-describedby="google-soon">
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5a5.6 5.6 0 0 1-2.4 3.6v3h3.9c2.2-2.1 3.5-5.1 3.5-8.8Z"></path><path fill="#34A853" d="M12 24c3.2 0 6-1.1 8-2.9l-3.9-3c-1.1.7-2.5 1.2-4.1 1.2-3.1 0-5.8-2.1-6.7-5H1.3v3.1A12 12 0 0 0 12 24Z"></path><path fill="#FBBC05" d="M5.3 14.3a7.2 7.2 0 0 1 0-4.6V6.6h-4a12 12 0 0 0 0 10.8l4-3.1Z"></path><path fill="#EA4335" d="M12 4.8c1.8 0 3.3.6 4.6 1.8l3.4-3.4A12 12 0 0 0 1.3 6.6l4 3.1c.9-2.8 3.6-4.9 6.7-4.9Z"></path></svg
          >
          Continuar con Google
          <span class="soon" id="google-soon">Próximamente</span>
        </button>

        <!-- Cuentas de prueba a un clic: quien evalúa entra sin buscar credenciales. -->
        <div class="demo-row">
          <span>Entrar con cuenta demo:</span>
          <button type="button" class="link" data-demo="student">Estudiante</button>
          <span aria-hidden="true">·</span>
          <button type="button" class="link" data-demo="teacher">Profesor</button>
        </div>
      </form>
    </section>

    <div class="marquee" aria-hidden="true">
      <div class="track">
        {[...HELLOS, ...HELLOS].map((h) => <span>{h}</span>)}
      </div>
    </div>
  </main>
</Base>

<style>
  /* Escena nocturna a sangre completa: Glo es el protagonista, el formulario es "la respuesta". */
  .login {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(340px, 440px);
    grid-template-rows: auto 1fr auto;
    column-gap: clamp(24px, 4vw, 72px);
    min-height: 100dvh;
    padding: clamp(16px, 2.4vw, 36px) clamp(16px, 3vw, 48px) 0;
    overflow: hidden;
  }

  .top {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    animation: fade 0.8s var(--ease-out) both;
  }
  .meta {
    margin: 0;
    font-size: 0.8rem;
    opacity: 0.7;
  }

  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 0;
    padding-block: clamp(16px, 4vh, 48px);
  }
  /* Lo que dice Glo, en tamaño póster. Glo flota por delante de las letras. */
  .say {
    max-width: 8.5ch;
    font-size: clamp(2.6rem, min(7.4vw, 13vh), 7rem);
  }
  canvas {
    position: absolute;
    z-index: 1;
    right: -7%;
    bottom: 0;
    width: min(60%, 68vh, 600px);
    aspect-ratio: 1;
    animation: glo-in 1.1s 0.2s var(--ease-spring) both; /* keyframes en glo.css */
  }

  /* Tarjeta de papel con colita de diálogo apuntando a Glo: responder es conversar. */
  .panel {
    position: relative;
    z-index: 2; /* si la tarjeta crece, tapa la cinta de "hola" en vez de quedar debajo */
    align-self: center;
    padding: clamp(28px, 3vw, 40px);
    border-radius: 28px;
    color: var(--ink);
    background: var(--surface);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.6) inset,
      0 40px 80px -30px rgb(0 0 0 / 0.65);
    animation: card-in 0.9s 0.15s var(--ease-out) both;
  }
  /* En oscuro: tarjeta índigo elevada sobre la medianoche, con filo de luz en vez de sombra blanca. */
  :global([data-theme="dark"]) .panel {
    --surface: #171d44;
    --bg: #0d1232;
    --line: #2e3672;
    --muted: #a9aed0;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.07) inset,
      0 1px 0 rgb(255 255 255 / 0.1) inset,
      0 40px 80px -30px rgb(0 0 0 / 0.8);
  }
  .panel::before {
    content: "";
    position: absolute;
    left: -14px;
    top: 42%;
    width: 30px;
    height: 30px;
    background: var(--surface);
    border-radius: 0 0 0 6px;
    rotate: 45deg;
    clip-path: polygon(0 0, 0 100%, 100% 100%);
  }
  h1 {
    font-size: clamp(1.5rem, 2.2vw, 1.85rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin: 0 0 8px;
  }
  .lead {
    color: var(--muted);
    font-size: 0.9rem;
    margin: 0 0 28px;
  }

  .field {
    margin-bottom: 16px;
  }
  label {
    display: block;
    font-weight: 500;
    font-size: 0.85rem;
    margin-bottom: 6px;
    transition: color 0.2s;
  }
  .field:focus-within label {
    color: var(--accent);
  }
  input {
    width: 100%;
    height: 52px;
    padding: 0 16px;
    font: inherit;
    color: var(--ink);
    background: var(--bg);
    border: 1.5px solid transparent;
    border-radius: 14px;
    transition:
      border-color 0.2s,
      background 0.2s,
      box-shadow 0.25s var(--ease-out);
  }
  input::placeholder {
    color: color-mix(in srgb, var(--muted) 65%, transparent);
  }
  input:hover {
    border-color: var(--line);
  }
  input:focus {
    outline: none;
    background: var(--surface);
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }
  input[aria-invalid="true"] {
    border-color: var(--danger);
    box-shadow: 0 0 0 4px var(--danger-soft);
  }

  .password {
    position: relative;
  }

  .consent label {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin: 0;
    font-weight: 400;
    color: var(--muted);
    cursor: pointer;
  }
  .consent input {
    flex: none;
    width: 18px;
    height: 18px;
    margin: 1px 0 0;
    padding: 0;
    box-shadow: none;
    accent-color: var(--accent);
    cursor: pointer;
  }
  .consent input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .consent:focus-within label {
    color: var(--ink);
  }
  .consent a {
    color: var(--accent);
    text-underline-offset: 3px;
  }
  .password input {
    padding-right: 56px;
  }
  .toggle {
    position: absolute;
    right: 4px;
    top: 4px;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: var(--muted);
    transition:
      background 0.2s,
      color 0.2s;
  }
  .toggle:hover {
    background: var(--accent-soft);
    color: var(--accent);
  }
  .toggle svg {
    width: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }
  /* La barra se "dibuja" al ocultar: micro animación con stroke-dashoffset. */
  .slash {
    stroke-dasharray: 23;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 0.3s var(--ease-out);
  }
  .toggle[aria-pressed="true"] .slash {
    stroke-dashoffset: 23;
  }

  .hint,
  .field-error {
    margin: 6px 0 0;
    font-size: 0.8rem;
  }
  .hint {
    color: var(--muted);
  }
  .field-error:empty,
  .form-error:empty {
    display: none;
  }
  .field-error,
  .form-error {
    color: var(--danger);
    animation: fade 0.3s var(--ease-out);
  }
  .form-error {
    margin: 0 0 16px;
    padding: 12px 14px;
    border-radius: 12px;
    background: var(--danger-soft);
    font-size: 0.85rem;
  }

  button {
    font: inherit;
    cursor: pointer;
  }
  .primary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    height: 54px;
    margin-top: 8px;
    border: 0;
    border-radius: 14px;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 500;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.18),
      0 12px 24px -12px color-mix(in srgb, var(--accent) 80%, transparent);
    transition:
      background 0.2s,
      transform 0.15s var(--ease-out),
      box-shadow 0.25s var(--ease-out);
  }
  .primary:hover {
    background: color-mix(in srgb, var(--accent) 88%, black);
  }
  .primary:active {
    transform: translateY(1px) scale(0.99);
  }
  .arrow {
    width: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: translate 0.3s var(--ease-spring);
  }
  .primary:hover .arrow {
    translate: 4px 0;
  }
  .primary[aria-busy="true"] {
    cursor: progress;
  }
  .primary[aria-busy="true"] .arrow {
    display: none;
  }
  .primary[aria-busy="true"] .label::after {
    content: "";
    display: inline-block;
    width: 1.2em;
    text-align: left;
    animation: dots 1s steps(4) infinite;
  }

  .google {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    height: 48px;
    margin-top: 10px;
    border: 1.5px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
    color: var(--ink);
    font-weight: 500;
    opacity: 0.6;
    cursor: not-allowed;
  }
  .google svg {
    width: 18px;
  }
  .soon {
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--bg);
    color: var(--muted);
    font-size: 0.7rem;
  }

  .demo-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    margin-top: 18px;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .link {
    padding: 0;
    border: 0;
    background: none;
    color: var(--accent);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: text-underline-offset 0.2s var(--ease-out);
  }
  .link:hover {
    text-underline-offset: 6px;
  }

  /* Cinta de "hola" en muchos idiomas: lo global, en movimiento. */
  .marquee {
    grid-column: 1 / -1;
    margin-inline: calc(-1 * clamp(16px, 3vw, 48px));
    padding-block: 14px;
    border-top: 1px solid rgb(246 241 231 / 0.12);
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    animation: fade 1s 0.6s both;
  }
  .track {
    display: flex;
    width: max-content;
    animation: marquee 50s linear infinite;
  }
  .track span {
    display: flex;
    align-items: center;
    gap: 28px;
    padding-right: 28px;
    font-size: 0.95rem;
    white-space: nowrap;
    opacity: 0.45;
  }
  .track span::after {
    content: "/";
    color: var(--glo);
    font-weight: 300;
  }

  .shake {
    animation: shake 0.4s var(--ease-out);
  }

  @keyframes fade {
    from {
      opacity: 0;
      translate: 0 8px;
    }
  }
  @keyframes card-in {
    from {
      opacity: 0;
      translate: 24px 0;
    }
  }
  @keyframes glo-in {
    from {
      opacity: 0;
      scale: 0.6;
      translate: 0 40px;
    }
  }
  @keyframes marquee {
    to {
      translate: -50% 0;
    }
  }
  @keyframes shake {
    25%,
    75% {
      translate: -5px 0;
    }
    50% {
      translate: 5px 0;
    }
  }
  @keyframes dots {
    0% {
      content: "";
    }
    25% {
      content: ".";
    }
    50% {
      content: "..";
    }
    75% {
      content: "...";
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
    }
  }

  /* Escritorio: el login mide exactamente la ventana. Los espacios verticales escalan con la altura,
     así un error de contraseña no empuja la página ni hace aparecer scroll. */
  @media (min-width: 861px) and (min-height: 560px) {
    .login {
      height: 100dvh;
      min-height: 0;
      grid-template-rows: auto minmax(0, 1fr) auto;
    }
    .panel {
      padding: clamp(20px, 4vh, 40px) clamp(28px, 3vw, 40px);
    }
    .lead {
      margin-bottom: clamp(12px, 3vh, 28px);
    }
    .field {
      margin-bottom: clamp(8px, 1.6vh, 16px);
    }
    input {
      height: clamp(44px, 6vh, 52px);
    }
    .toggle {
      top: 50%;
      translate: 0 -50%;
      height: calc(100% - 8px);
    }
    .primary {
      height: clamp(46px, 6vh, 54px);
    }
    .google {
      height: clamp(40px, 5.2vh, 48px);
      margin-top: clamp(6px, 1.2vh, 10px);
    }
    .form-error {
      margin-bottom: clamp(8px, 1.6vh, 16px);
      padding-block: clamp(8px, 1.2vh, 12px);
    }
    .demo-row {
      margin-top: clamp(10px, 2vh, 18px);
    }
    .marquee {
      padding-block: clamp(8px, 1.6vh, 14px);
    }
  }

  /* Móvil: Glo se sienta en el borde de la tarjeta (su sombra cae sobre el papel). */
  @media (max-width: 860px) {
    .login {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto 1fr auto;
      row-gap: 0;
    }
    .top .meta {
      display: none;
    }
    .hero {
      z-index: 2;
      display: block;
      padding: 28px 0 44px;
    }
    .hero::before {
      top: -24px;
      font-size: 13rem;
    }
    .say {
      max-width: 7.5ch;
      font-size: clamp(2.4rem, 12vw, 3.6rem);
    }
    .say-es,
    .by {
      max-width: 52%;
    }
    .say-es {
      margin-top: 14px;
      font-size: 0.85rem;
    }
    canvas {
      right: -10px;
      bottom: -64px;
      width: min(56vw, 260px);
    }
    .panel {
      align-self: start;
      margin-bottom: 20px;
      padding-top: 32px;
      animation-name: sheet-in;
    }
    .panel::before {
      display: none;
    }
    h1 {
      max-width: 10ch;
    }
    .marquee {
      margin-top: auto;
    }
  }
  @keyframes sheet-in {
    from {
      opacity: 0;
      translate: 0 40px;
    }
  }
</style>

<script>
  import type { CoachState } from "../lib/coach";
  import { mountGlo } from "../lib/glo";
  import { firstVisit, handoff, splash } from "../lib/splash";

  const API = "/api/v1";
  const DEMO = {
    student: { email: "estudiante@globalai.demo", password: "Demo1234!" },
    teacher: { email: "profesor@globalai.demo", password: "Demo1234!" },
  };
  // Cada rol aterriza en su pantalla.
  const home = (role: string) => (role === "student" ? "/dashboard" : "/teacher");
  type LoginState = Exclude<CoachState, "present">;
  const LINES: Record<LoginState, [string, string]> = {
    // *palabra* = se resalta en coral.
    idle: ["Hi, I'm Glo. Let's find your *level.*", "Hola, soy Glo. Descubramos tu nivel de inglés."],
    email: ["Nice to *meet* you!", "¡Un gusto conocerte!"],
    password: ["I'm not *looking.* Promise.", "No estoy mirando. Lo prometo."],
    peek: ["Oops! I can *see* it.", "¡Uy! Ahora sí la veo."],
    loading: ["Let me *check*…", "Déjame revisar…"],
    error: ["Hmm. Let's try *again.*", "Mmm. Intentémoslo de nuevo."],
    success: ["You're in. *Let's go!*", "Estás dentro. ¡Vamos!"],
  };

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const form = $<HTMLFormElement>("login");
  const email = $<HTMLInputElement>("email");
  const password = $<HTMLInputElement>("password");
  const terms = $<HTMLInputElement>("terms");
  const toggle = $<HTMLButtonElement>("toggle");
  const submit = $<HTMLButtonElement>("submit");
  const formError = $("form-error");
  // Primera visita de la sesión: Glo gris que se llena de color mientras carga la página.
  const load = splash(firstVisit());
  const glo = mountGlo({
    canvas: $<HTMLCanvasElement>("coach"),
    say: $("say"),
    sayEs: $("say-es"),
    scene: document.querySelector<HTMLElement>(".login")!,
  });
  glo.speak(...LINES.idle);
  let current: LoginState = "idle";
  function mood(s: LoginState) {
    glo.coach?.setState(s);
    if (s === current) return;
    current = s;
    glo.speak(...LINES[s]);
  }


  const fieldMood = () =>
    document.activeElement === email ? "email"
    : document.activeElement === password || document.activeElement === toggle ? (password.type === "text" ? "peek" : "password")
    : "idle";

  email.addEventListener("focus", () => mood("email"));
  password.addEventListener("focus", () => mood(fieldMood()));
  for (const input of [email, password]) {
    input.addEventListener("blur", () => setTimeout(() => current !== "loading" && mood(fieldMood()), 0));
    input.addEventListener("input", () => {
      glo.coach?.pulse();
      setFieldError(input, "");
    });
  }

  // Glo sigue con la mirada el cursor mientras escribes el correo (~32 caracteres llenan el campo).
  const followCaret = () => glo.coach?.gaze((email.selectionStart ?? email.value.length) / 32);
  for (const ev of ["input", "keyup", "click", "focus"]) email.addEventListener(ev, followCaret);

  toggle.addEventListener("click", () => {
    const show = password.type === "password";
    password.type = show ? "text" : "password";
    toggle.setAttribute("aria-pressed", String(show));
    toggle.querySelector(".sr-only")!.textContent = show ? "Ocultar contraseña" : "Mostrar contraseña";
    mood(show ? "peek" : "password");
  });

  const caps = $("caps");
  const checkCaps = (e: KeyboardEvent) => (caps.hidden = !e.getModifierState?.("CapsLock"));
  password.addEventListener("keydown", checkCaps);
  password.addEventListener("keyup", checkCaps);

  function setFieldError(input: HTMLInputElement, msg: string) {
    $(`${input.id}-error`).textContent = msg;
    if (msg) input.setAttribute("aria-invalid", "true");
    else input.removeAttribute("aria-invalid");
  }

  function validate() {
    const e = email.value.trim();
    const emailMsg = !e ? "Escribe tu correo electrónico."
      : !email.checkValidity() ? "Revisa el correo, debe verse así: nombre@correo.com"
      : "";
    const passMsg = password.value ? "" : "Escribe tu contraseña.";
    setFieldError(email, emailMsg);
    setFieldError(password, passMsg);
    const termsOk = checkTerms();
    (emailMsg ? email : passMsg ? password : termsOk ? null : terms)?.focus();
    return !emailMsg && !passMsg && termsOk;
  }

  function checkTerms() {
    setFieldError(terms, terms.checked ? "" : "Acepta los Términos y la Política de privacidad para continuar.");
    return terms.checked;
  }
  terms.addEventListener("change", () => setFieldError(terms, ""));

  function fail(msg: string) {
    formError.textContent = msg;
    form.classList.remove("shake");
    void form.offsetWidth;
    form.classList.add("shake");
    mood("error");
  }

  let busy = false;
  form.addEventListener("submit", async (ev) => {
    ev.preventDefault();
    if (busy) return;
    formError.textContent = "";
    if (!validate()) return fail(""); // los errores ya están junto a cada campo

    busy = true;
    submit.setAttribute("aria-busy", "true");
    submit.querySelector(".label")!.textContent = "Entrando";
    mood("loading");
    try {
      const res = await fetch(`${API}/auth/login`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email: email.value.trim(), password: password.value, accept_terms: terms.checked }),
      });
      if (res.ok) {
        submit.removeAttribute("aria-busy");
        submit.querySelector(".label")!.textContent = "¡Listo!";
        mood("success");
        const { role } = await res.json();
        handoff.mark("Loading"); // la siguiente pantalla abre con la carga de Glo mientras trae los datos
        setTimeout(() => location.assign(home(role)), 900);
        return;
      }
      const body = await res.json().catch(() => null);
      fail(body?.error?.message ?? "Algo salió mal. Inténtalo de nuevo.");
    } catch {
      fail("No pudimos conectar con el servidor. Revisa tu conexión e inténtalo de nuevo.");
    }
    busy = false;
    submit.removeAttribute("aria-busy");
    submit.querySelector(".label")!.textContent = "Entrar";
  });

  // Cuenta demo: se "escribe" sola para que el coach reaccione, y entra.
  document.querySelectorAll<HTMLButtonElement>("[data-demo]").forEach((b) => b.addEventListener("click", async () => {
    if (busy) return;
    // El consentimiento no se marca solo, ni siquiera en la cuenta demo.
    if (!checkTerms()) return terms.focus(), fail("");
    const account = DEMO[b.dataset.demo as keyof typeof DEMO];
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    for (const [input, value] of [[email, account.email], [password, account.password]] as const) {
      input.focus();
      input.value = "";
      for (const ch of value) {
        input.value += ch;
        input.dispatchEvent(new Event("input"));
        if (!reduced) await new Promise((r) => setTimeout(r, 28));
      }
    }
    form.requestSubmit();
  }));

  // Si ya hay sesión, no tiene sentido mostrar el login.
  // Progreso real de la carga: fuentes, motor 3D y comprobación de sesión.
  const me = fetch(`${API}/auth/me`).then(
    async (r) => {
      if (!r.ok) return;
      const { role } = await r.json();
      handoff.mark("Loading");
      location.replace(home(role));
      return new Promise(() => {}); // se navega: la pantalla sigue hasta que cargue el dashboard
    },
    () => {},
  );
  Promise.all([
    document.fonts.ready.then(() => load.progress(0.35)),
    glo.ready.then(() => load.progress(0.75)),
    me.then(() => load.progress(0.95)),
  ]).then(load.done);
</script>
