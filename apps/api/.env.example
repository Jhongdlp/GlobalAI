ENV=local
DATABASE_URL=postgresql+asyncpg://globalai:globalai@localhost:5432/globalai
# Neon con pooler: DATABASE_URL=postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require
DB_USE_PGBOUNCER=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

JWT_SECRET=change-me-in-production-please-32b
CORS_ORIGINS=["http://localhost:4321"]

# IA: cambiar de proveedor = cambiar AI_PROVIDER (sin key -> feedback por plantilla)
AI_PROVIDER=mock            # anthropic | openai | mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Cualquier API compatible con OpenAI: Groq, OpenRouter, Ollama (http://localhost:11434/v1), Gemini...
OPENAI_BASE_URL=https://api.openai.com/v1

# Voz (sin key -> voz del navegador)
TTS_PROVIDER=none
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Speaking: transcripción con ElevenLabs Scribe (misma key). Sin esto la pregunta oral no se califica.
STT_PROVIDER=none
ELEVENLABS_STT_MODEL=scribe_v2
